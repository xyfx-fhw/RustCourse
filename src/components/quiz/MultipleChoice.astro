---
// src/components/quiz/MultipleChoice.astro
// 单道选择题组件：渲染题目、选项，处理答题交互并上报事件

interface Props {
  question: string;
  options: string[];
  answer: number;        // 正确选项的下标（0-based）
  explanation: string;
  questionIdx: number;   // 用于 id 前缀区分多题
}

const { question, options, answer, explanation, questionIdx } = Astro.props;
---

<div class="mc-block" data-question-idx={questionIdx} data-answer={answer}>
  <p class="mc-question">
    <span class="mc-qnum">{questionIdx + 1}.</span> {question}
  </p>
  <ul class="mc-options">
    {options.map((opt) => (
      <li>
        <button class="mc-option" type="button">{opt}</button>
      </li>
    ))}
  </ul>
  <div class="mc-explanation" hidden>{explanation}</div>
</div>

<script>
  // 初始化所有选择题的交互逻辑
  document.querySelectorAll<HTMLElement>('.mc-block').forEach(block => {
    const answer = parseInt(block.dataset.answer ?? '0');
    const qIdx = parseInt(block.dataset.questionIdx ?? '0');
    const btns = Array.from(block.querySelectorAll<HTMLButtonElement>('.mc-option'));
    const explanationEl = block.querySelector<HTMLElement>('.mc-explanation');
    let answered = false;

    btns.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        if (answered) return;
        answered = true;
        const correct = i === answer;
        btn.classList.add(correct ? 'correct' : 'wrong');
        if (!correct) btns[answer]?.classList.add('correct');
        btns.forEach(b => (b.disabled = true));
        if (explanationEl) explanationEl.hidden = false;
        // 派发到最近的 .quiz-page 祖先，避免全局事件总线的多实例干扰
        const quizPageEl = block.closest('.quiz-page');
        quizPageEl?.dispatchEvent(
          new CustomEvent('quiz-answer', { detail: { idx: qIdx, correct }, bubbles: false })
        );
      });
    });
  });
</script>

<style>
  .mc-block { margin-bottom: 2rem; }
  .mc-question { font-size: 1rem; font-weight: 500; margin-bottom: 0.875rem; line-height: 1.6; }
  .mc-qnum { color: var(--color-accent); font-weight: 700; margin-right: 0.375rem; }
  .mc-options { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .mc-option {
    width: 100%; text-align: left; padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border); border-radius: 6px;
    background: transparent; cursor: pointer; font-size: 0.9375rem;
    color: var(--color-text); transition: border-color 0.15s, background 0.15s;
  }
  .mc-option:hover:not(:disabled) { border-color: var(--color-accent); background: rgba(206,65,43,0.06); }
  .mc-option:disabled { cursor: default; }
  .mc-option.correct { background: rgba(34,197,94,0.12); border-color: var(--color-success); color: var(--color-success); }
  .mc-option.wrong   { background: rgba(239,68,68,0.12);  border-color: var(--color-error);   color: var(--color-error); }
  .mc-explanation {
    margin-top: 0.75rem; padding: 0.75rem 1rem;
    background: rgba(255,255,255,0.04); border-radius: 6px;
    font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6;
  }
</style>
